# Fine-grained personal access token: ONLY the module repos, ONLY "Contents: Read-only".
GITHUB_TOKEN=github_pat_REPLACE_ME

# Where the module-id -> repository mapping lives (see config.example.json).
CONFIG_FILE=./config.json

# Listen address. Keep 127.0.0.1 unless Foundry runs in Docker (see README).
HOST=127.0.0.1
PORT=8787

# Base of the links written into manifests. Must be reachable from the Foundry server process.
# Defaults to http://localhost:<PORT>.
PUBLIC_BASE_URL=http://localhost:8787

# Administration page (/_admin/) and update-notification e-mails: settings in admin.json, created by the installers.
# Defaults to admin.json next to CONFIG_FILE. The page is off until that file holds a password hash
# (node src/admin.js setup admin.json with FOUNDRY_PROXY_ADMIN_PASSWORD set, or the installer's --set-admin-password).
# ADMIN_FILE=./admin.json
# Extra host names the admin page answers to (besides localhost, 127.0.0.1, HOST and PUBLIC_BASE_URL's host).
# ADMIN_HOSTS=proxy.example.lan
